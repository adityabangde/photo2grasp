<mujoco model="box">
  <!-- Small kraft cardboard cube ('YOU DROPPED THIS KING' box). Not identifiable online (generic shipping box, label unreadable). Size estimated from the video with its AprilTags as a ruler (faces ~40-52 mm): ~5 cm cube - measure with a ruler to confirm. Mass: empty small kraft box ~30 g (estimate, weigh to confirm). Friction: cardboard on cloth ~0.5 -->
  <compiler meshdir="."/>
  <default>
    <default class="box_visual">
      <geom type="mesh" contype="0" conaffinity="0" group="2"/>
    </default>
    <default class="box_collision">
      <geom type="mesh" group="3" condim="4" friction="0.5 0.005 0.0001"/>
    </default>
  </default>
  <asset>
    <mesh name="box_visual" file="box_visual.obj"/>
    <texture name="box_texture" type="2d" file="box_texture.png"/>
    <material name="box_material" texture="box_texture"/>
  </asset>
  <worldbody>
    <body name="box">
      <freejoint name="box_joint"/>
      <inertial pos="0 0 0.025" mass="0.03" fullinertia="1.25e-05 1.25e-05 1.25e-05 -0 -0 -0"/>
      <geom class="box_visual" mesh="box_visual" material="box_material"/>
      <geom class="box_collision" type="box" size="0.025 0.025 0.025" pos="0 0 0.025"/>
    </body>
  </worldbody>
</mujoco>
